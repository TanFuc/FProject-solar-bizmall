APP_ENV=production
BMSOLAR_BIND_ADDRESS=127.0.0.1
PORT=3001
DATABASE_URL=sqlite:///var/www/vhosts/REPLACE_DOMAIN/private/bmsolar/data/bmsolar.db
WEB_PUBLIC_URL=https://REPLACE_DOMAIN
APP_BASE_URL=https://REPLACE_DOMAIN
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
STORAGE_PROVIDER=r2
LOCAL_STORAGE_PATH=/var/www/vhosts/REPLACE_DOMAIN/private/bmsolar/data/storage
R2_ENABLED=true
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
IMAGE_BASE_URL=

CORS_ALLOWED_ORIGINS=https://REPLACE_DOMAIN
JWT_ACCESS_TTL_SECONDS=86400
JWT_REFRESH_TTL_SECONDS=604800
R2_REGION=auto
MAX_UPLOAD_MB=25
IMAGE_MAX_WIDTH=2400
IMAGE_MAX_HEIGHT=2400
IMAGE_QUALITY=82
IMAGE_THUMB_WIDTH=480
IMAGE_MEDIUM_WIDTH=1200
IMAGE_LARGE_WIDTH=1800
IMAGE_OUTPUT_FORMAT=jpeg
CACHE_TTL_SECONDS=300
RATE_LIMIT_RPS=10
MAX_CONCURRENT_REQUESTS=16
LOG_LEVEL=info
# Optional Redis connection and credentials
REDIS_URL=
REDIS_PASSWORD=
REDIS_DB=0
