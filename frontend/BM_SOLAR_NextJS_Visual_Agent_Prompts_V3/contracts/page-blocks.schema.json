{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/bm-solar/page-blocks-v1.schema.json",
  "title": "BM SOLAR CMS Page Builder Blocks v1",
  "description": "Discriminated union of allowed CMS blocks; media IDs refer to approved managed assets.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "schemaVersion",
        "type",
        "headline",
        "desktopMediaId",
        "primaryAction",
        "overlayPreset",
        "minHeightPreset"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "schemaVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "const": "hero_media"
        },
        "headline": {
          "type": "string",
          "maxLength": 120
        },
        "eyebrow": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 50
            },
            {
              "type": "null"
            }
          ]
        },
        "subheading": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 180
            },
            {
              "type": "null"
            }
          ]
        },
        "desktopMediaId": {
          "type": "string",
          "format": "uuid"
        },
        "mobileMediaId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "posterMediaId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "primaryAction": {
          "$ref": "#/$defs/action"
        },
        "secondaryAction": {
          "anyOf": [
            {
              "$ref": "#/$defs/action"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlayPreset": {
          "type": "string",
          "enum": [
            "soft",
            "dark_gradient",
            "none"
          ]
        },
        "minHeightPreset": {
          "type": "string",
          "enum": [
            "large",
            "full_viewport",
            "compact"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "schemaVersion",
        "type",
        "headline",
        "audiences",
        "defaultAudience"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
