          }
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "schemaVersion",
        "type",
        "headline",
        "projectIds",
        "maxItems"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
          "type": "integer",
