        "headline": {
          "type": "string"
        },
        "postIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "schemaVersion",
        "type",
