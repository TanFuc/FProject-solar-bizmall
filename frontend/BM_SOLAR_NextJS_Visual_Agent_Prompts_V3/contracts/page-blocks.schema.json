            1
          ]
        },
        "type": {
          "const": "category_grid"
        },
        "headline": {
          "type": "string"
        },
        "categoryIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "maxItems": 12
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    {
      "type": "object",
