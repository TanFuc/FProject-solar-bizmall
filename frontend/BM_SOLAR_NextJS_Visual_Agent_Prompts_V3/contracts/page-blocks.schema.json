      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "schemaVersion",
        "type",
        "headline",
        "socialChannelIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "schemaVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "const": "social_feed"
        },
        "headline": {
          "type": "string"
        },
        "socialChannelIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
