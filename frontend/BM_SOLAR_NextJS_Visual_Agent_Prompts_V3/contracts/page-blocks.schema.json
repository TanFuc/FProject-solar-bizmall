      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "schemaVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "const": "rich_text"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/richTextNode"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "position",
        "schemaVersion",
        "type",
        "mediaId",
        "posterMediaId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
          "type": "integer",
          "minimum": 0
        },
        "schemaVersion": {
          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "const": "video_feature"
        },
        "headline": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mediaId": {
          "type": "string",
          "format": "uuid"
        },
        "posterMediaId": {
          "type": "string",
          "format": "uuid"
        },
        "transcript": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
