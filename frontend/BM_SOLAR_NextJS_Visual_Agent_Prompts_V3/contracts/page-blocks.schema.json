  ],
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "label",
        "available",
        "href"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "internal",
            "external",
            "lead_form",
            "call",
            "zalo",
            "email"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 80
        },
        "available": {
          "type": "boolean"
        },
        "href": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2048
        },
        "openInNewTab": {
          "type": "boolean"
        }
      }
    },
    "richTextNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "paragraph",
            "heading",
            "list",
            "list_item",
            "quote",
            "link",
            "text",
            "image",
            "table"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "level": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 6
        },
        "href": {
          "type": [
            "string",
            "null"
          ]
        },
        "mediaId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
