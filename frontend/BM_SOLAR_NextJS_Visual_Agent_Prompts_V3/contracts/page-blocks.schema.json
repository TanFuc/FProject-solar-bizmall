          "type": "integer",
          "enum": [
            1
          ]
        },
        "type": {
          "const": "need_selector"
        },
        "headline": {
          "type": "string"
        },
        "audiences": {
          "type": "array",
          "items": {
            "enum": [
              "home",
              "business",
              "factory"
            ],
            "type": "string"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "defaultAudience": {
          "type": "string"
        }
      }
    },
    {
      "type": "object",
