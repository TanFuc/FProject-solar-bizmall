# Server-side frontend settings (never commit real secrets)
NEXT_PUBLIC_SITE_URL=https://www.example.com
CMS_PUBLIC_API_BASE_URL=https://api.example.com
CMS_REVALIDATE_WEBHOOK_SECRET=replace_with_long_random_secret
# If using an authenticated server-side BFF for admin SEO operations:
CMS_ADMIN_SERVER_API_BASE_URL=https://api.example.com
# Server-side admin auth must use user session / backend auth; do not paste static admin bearer tokens here.
# Google Search Console credentials belong in NestJS backend, NOT Next.js NEXT_PUBLIC variables.
