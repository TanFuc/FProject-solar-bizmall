# ==============================================================================
# BM SOLAR — Root Git Ignore
# Covers Next.js Frontend, Golang Backend, Local Storage, OS & Tooling
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# Next.js Build Outputs & Caches
# ------------------------------------------------------------------------------
.next/
out/
build/
dist/
.swc/
next-env.d.ts.bak
*.tsbuildinfo

# ------------------------------------------------------------------------------
# Golang Binaries, Test Artifacts & Vendor
# ------------------------------------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
vendor/

# ------------------------------------------------------------------------------
# Environment Variables, Secrets & Tokens (NEVER commit secrets!)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt

# ------------------------------------------------------------------------------
# Databases, Media Storage & Runtime Locks
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-shm
*.db-wal
backend/storage/*.db
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
storage/
uploads/
tmp/
*.pid
app.lock

# ------------------------------------------------------------------------------
# Testing, Coverage & Playwright Outputs
# ------------------------------------------------------------------------------
coverage/
.nyc_output/
playwright-report/
blob-report/
playwright/.cache/
test-results/

# ------------------------------------------------------------------------------
# IDE, Editors & Agent Tooling Metadata
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# Antigravity / AI Assistant Transient Workspace Caches
.gemini/
.agent/
.agents/
.codex/
.impeccable/
.opencode/
scratch/
*.log

