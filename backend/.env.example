# ========================================================
# BM SOLAR — BACKEND PRODUCTION & LOCAL CONFIGURATION
# ========================================================
APP_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Database (MariaDB / MySQL / SQLite)
# Production MariaDB format: mysql://user:password@tcp(host:3306)/dbname?charset=utf8mb4&parseTime=True&loc=UTC
# Local dev default fallback: sqlite://bmsolar.db
DATABASE_URL=sqlite://bmsolar.db

# JWT Authentication
JWT_ACCESS_SECRET=dev_jwt_access_secret_key_at_least_32_bytes_long!
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_key_at_least_32_bytes_long!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# ========================================================
# STORAGE & PRODUCTION MEDIA CDN
# ========================================================
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage

# Public URL prefix returned after upload. In production, use the image domain
# (for example https://images.example.com/storage), never an r2.dev URL.
IMAGE_BASE_URL=

# Cloudflare R2 Storage (S3-Compatible)
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Deprecated local fallback. Use IMAGE_BASE_URL for new configurations.
R2_PUBLIC_BASE_URL=
R2_REGION=auto

# Image Processing Specs & Upload Limits
MAX_UPLOAD_MB=25
IMAGE_MAX_WIDTH=2400
IMAGE_MAX_HEIGHT=2400
IMAGE_QUALITY=82
IMAGE_THUMB_WIDTH=480
IMAGE_MEDIUM_WIDTH=1200
IMAGE_LARGE_WIDTH=1800
IMAGE_OUTPUT_FORMAT=jpeg

# ========================================================
# CACHE, CONCURRENCY & PRODUCTION OPTIMIZATION
# ========================================================
CACHE_TTL_SECONDS=300
RATE_LIMIT_RPS=10
MAX_CONCURRENT_REQUESTS=0

# Runtime CPU optimization:
# Set to 0 for automatic container CPU quota detection via automaxprocs (prevents K8s/Docker CPU throttling).
# Set to >0 to override GOMAXPROCS manually.
RUNTIME_GOMAXPROCS=0

# Process single-instance lock path (optional, e.g. /tmp/bmsolar.lock)
APP_INSTANCE_LOCK_PATH=

# Redis (Distributed Cache & Distributed Rate Limiting)
# If Redis is unavailable, the system automatically falls back to in-memory store
REDIS_ADDR=localhost:6379
REDIS_URL=
REDIS_PASSWORD=
REDIS_DB=0

# ========================================================
# SEO & OBSERVABILITY
# ========================================================
SEO_AI_PROVIDER=deterministic
SEO_AI_API_KEY=
SEARCH_CONSOLE_ENABLED=false
LOG_LEVEL=info
